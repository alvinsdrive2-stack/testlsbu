generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Section {
  PRETEST
  POSTTEST
}

enum ParticipantStage {
  REGISTERED
  PRETEST_DONE
  POSTTEST_PASSED
}

model Module {
  id                   String     @id @default(cuid())
  title                String
  description          String?
  shuffleQuestions     Boolean    @default(false)
  shuffleOptions       Boolean    @default(false)
  pretestDurationMin   Int        @default(30)
  posttestDurationMin  Int        @default(30)
  pretestPassingGrade  Int        @default(0)
  posttestPassingGrade Int        @default(70)
  showAnswerReview     Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  questions            Question[]
  materials            Material[]
  activities           Activity[]

  @@map("module")
}

model Question {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  section     Section
  text        String
  explanation String? @db.Text
  order       Int
  options     Option[]
  answers     Answer[]

  @@index([moduleId, section])
  @@map("question")
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean
  answers    Answer[]

  @@index([questionId])
  @@map("option")
}

model Material {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  content  String
  videoUrl String?
  pdfUrl   String?
  order    Int

  @@index([moduleId])
  @@map("material")
}

model Activity {
  id                String        @id @default(cuid())
  moduleId          String
  module            Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title             String
  registrationStart DateTime?
  pretestStart      DateTime?
  materialStart     DateTime?
  posttestStart     DateTime?
  closedAt          DateTime?
  createdAt         DateTime      @default(now())
  participants      Participant[]

  @@index([moduleId])
  @@map("activity")
}

model Participant {
  id              String           @id @default(cuid())
  activityId      String
  activity        Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  token           String           @unique @default(uuid())
  nama            String
  badanUsaha      String
  npwp            String
  wa              String
  email           String
  isGapensiMember Boolean
  stage           ParticipantStage @default(REGISTERED)
  attempts            Attempt[]
  certificateNumber   String?          @unique
  certificateIssuedAt DateTime?
  createdAt           DateTime         @default(now())

  @@index([activityId])
  @@map("participant")
}

model Attempt {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  section       Section
  seed          Int
  score         Int?
  passed        Boolean?
  startedAt     DateTime    @default(now())
  submittedAt   DateTime?
  answers       Answer[]

  @@index([participantId, section])
  @@map("attempt")
}

model Answer {
  id         String    @id @default(cuid())
  attemptId  String
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId   String?
  option     Option?   @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("answer")
}
