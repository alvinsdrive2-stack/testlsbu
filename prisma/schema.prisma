generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Section {
  PRETEST
  POSTTEST
}

enum ParticipantStage {
  REGISTERED
  PRETEST_DONE
  POSTTEST_PASSED
}

model Module {
  id                   String     @id @default(cuid())
  title                String
  description          String?
  shuffleQuestions     Boolean    @default(false)
  shuffleOptions       Boolean    @default(false)
  pretestDurationMin   Int        @default(30)
  posttestDurationMin  Int        @default(30)
  pretestPassingGrade  Int        @default(0)
  posttestPassingGrade Int        @default(70)
  showAnswerReview     Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  questions            Question[]
  materials            Material[]
  activities           Activity[]

  @@map("module")
}

model Question {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  section     Section
  text        String
  explanation String? @db.Text
  order       Int
  options     Option[]
  answers     Answer[]

  @@index([moduleId, section])
  @@map("question")
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean
  answers    Answer[]

  @@index([questionId])
  @@map("option")
}

model Material {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  content  String @db.MediumText
  videoUrl String?
  pdfUrl   String?
  order    Int

  @@index([moduleId])
  @@map("material")
}

model Activity {
  id                String        @id @default(cuid())
  moduleId          String
  module            Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title             String
  registrationStart DateTime?
  pretestStart      DateTime?
  materialStart     DateTime?
  posttestStart     DateTime?
  closedAt          DateTime?
  registrationOpen  Boolean?
  createdAt         DateTime      @default(now())
  participants      Participant[]

  @@index([moduleId])
  @@map("activity")
}

/// Identitas peserta — satu baris per email, berlaku lintas kegiatan.
/// Data di sini bukan milik satu pelatihan: peserta yang sama boleh ikut
/// pelatihan di hari berbeda tanpa terdaftar sebagai orang baru.
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  wa              String
  nama            String
  badanUsaha      String
  npwp            String
  isGapensiMember Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  participants    Participant[]

  @@index([wa])
  @@map("user")
}

/// Pendaftaran peserta ke SATU kegiatan (pelatihan). Identitas orangnya
/// dibaca dari relasi `user`, jadi email yang sama boleh muncul di banyak
/// baris participant asal activityId-nya berbeda.
model Participant {
  id              String           @id @default(cuid())
  activityId      String
  activity        Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String           @unique @default(uuid())
  stage           ParticipantStage @default(REGISTERED)
  attempts            Attempt[]
  certificate         Certificate?
  createdAt           DateTime         @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
  @@map("participant")
}

/// Sertifikat yang sudah terbit. Semua yang tercetak di gambarnya (nama,
/// perusahaan, NPWP, modul, tanggal ujian) DISALIN dari `user`/`activity`
/// saat penerbitan, bukan dibaca ulang tiap kali dirender. Jadi mengubah
/// profil peserta atau jadwal kegiatan tidak ikut mengubah sertifikat yang
/// sudah di tangan peserta.
model Certificate {
  id            String      @id @default(cuid())
  participantId String      @unique
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  number        String      @unique
  name          String
  company       String
  npwp          String
  moduleTitle   String
  examDate      DateTime?
  issuedAt      DateTime    @default(now())

  @@map("certificate")
}

model Attempt {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  section       Section
  seed          Int
  score         Int?
  passed        Boolean?
  startedAt     DateTime    @default(now())
  submittedAt   DateTime?
  answers       Answer[]

  @@index([participantId, section])
  @@map("attempt")
}

model Answer {
  id         String    @id @default(cuid())
  attemptId  String
  attempt    Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId   String?
  option     Option?   @relation(fields: [optionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("answer")
}

model CertificateConfig {
  id        String   @id
  fields    Json
  updatedAt DateTime @updatedAt

  @@map("certificate_config")
}
